{
  "name": "tinder-lite-backend",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/DEVASHRAY/tinder-lite-backend#readme",
  "bugs": {
    "url": "https://github.com/DEVASHRAY/tinder-lite-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEVASHRAY/tinder-lite-backend.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/app.js",
  "scripts": {
    "dev": "tsc --noEmit -p tsconfig.json && tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm ci && npm run build && pm2 restart tinder-lite-backend"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/validator": "^13.15.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
